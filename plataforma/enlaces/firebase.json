{
  "hosting": [
    {
      "target": "cid-benefi-atlixco",
      "public": "publico/cid-benefi-atlixco",
      "cleanUrls": true,
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "/",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ]
    },
    {
      "target": "cid-benefi-chiautzingo",
      "public": "publico/cid-benefi-chiautzingo",
      "cleanUrls": true,
      "rewrites": [
        {
          "source": "**",
